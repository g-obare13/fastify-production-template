{
  "name": "fastify-production-template",
  "version": "1.0.0",
  "description": "Production-grade Fastify TypeScript Backend Template with Dual REST & GraphQL APIs",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "imports": {
    "#src/*": {
      "production": "./dist/src/*",
      "default": "./src/*"
    },
    "#test/*": "./test/*",
    "#packages/*": {
      "production": "./dist/packages/*",
      "default": "./packages/*"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=production dist/src/server.js",
    "start:worker": "node --conditions=production dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test scripts && tsx scripts/lint-graphql-descriptions.ts && eslint --config eslint.config.imports.js src test scripts packages",
    "lint:imports": "eslint --config eslint.config.imports.js src test scripts packages",
    "lint:docs": "eslint --config eslint.config.docs.js src packages",
    "lint:graphql": "tsx scripts/lint-graphql-descriptions.ts",
    "lint:fix": "biome check --write src test scripts",
    "format": "biome format --write src test scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "gen:schema": "tsx scripts/generate-schema.ts",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "gen:env": "tsx scripts/generate-env.ts",
    "gen:sdk": "tsx scripts/generate-sdk.ts",
    "gen:graphql": "tsx scripts/generate-graphql.ts",
    "gen:errors": "tsx scripts/generate-error-codes.ts",
    "gen:all": "pnpm gen:schema && pnpm gen:openapi && pnpm gen:env && pnpm gen:errors && pnpm gen:sdk && pnpm gen:graphql",
    "build:sdk": "tsc -p packages/sdk/tsconfig.json",
    "gen:module": "tsx scripts/generate-module.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-storage": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@fastify/ajv-compiler": "4.0.7",
    "@fastify/compress": "^8.0.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/etag": "^6.2.1",
    "@fastify/fast-json-stringify-compiler": "5.1.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/under-pressure": "^9.0.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.56.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@pothos/core": "^4.4.1",
    "@pothos/plugin-dataloader": "^4.3.0",
    "@pothos/plugin-errors": "^4.2.0",
    "@pothos/plugin-relay": "^4.3.0",
    "@pothos/plugin-scope-auth": "^4.2.0",
    "@pothos/plugin-simple-objects": "^4.1.0",
    "@pothos/plugin-zod": "4.2.0",
    "@scalar/fastify-api-reference": "^1.25.12",
    "argon2": "^0.41.1",
    "bullmq": "^5.41.6",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.2",
    "fastify-type-provider-zod": "^4.0.2",
    "file-type": "^20.1.0",
    "graphql": "^16.10.0",
    "ioredis": "^5.5.0",
    "mercurius": "^16.0.0",
    "openapi-fetch": "^0.17.0",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "ulid": "^2.3.0",
    "undici": "^7.4.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^10.0.1",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.0.5",
    "drizzle-kit": "^0.30.4",
    "eslint": "^10.12.0",
    "eslint-plugin-jsdoc": "^65.3.0",
    "ioredis-mock": "^8.9.0",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.0.0",
    "testcontainers": "^10.18.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "argon2",
      "esbuild"
    ]
  }
}
