# Node environment (development, test, production) (Optional)
NODE_ENV=development

# Server listening port (Optional)
PORT=3000

# Server binding network host (Optional)
HOST=0.0.0.0

# Logging level (fatal, error, warn, info, debug, trace, silent) (Optional)
LOG_LEVEL=info

# Trusted reverse proxy IP list or hop count (fail-safe in production) (Optional)
TRUST_PROXY=127.0.0.1,::1

# Base path prefix for all REST routes (Optional)
API_PREFIX=/v1

# Toggle REST API surface on/off (Optional)
REST_ENABLED=true

# Toggle GraphQL API surface on/off (Optional)
GRAPHQL_ENABLED=true

# Toggle API documentation UI and spec endpoints on/off (defaults to false in production) (Optional)
DOCS_ENABLED=true

# Interactive documentation UI renderer: scalar or swagger (Optional)
DOCS_UI=scalar

# HTTP Basic Auth username to protect docs in staging/production (Optional)
DOCS_BASIC_AUTH_USER=

# HTTP Basic Auth password to protect docs in staging/production (Optional)
DOCS_BASIC_AUTH_PASSWORD=

# Serve printed GraphQL schema at /schema.graphql (Optional)
DOCS_EXPOSE_SCHEMA=true

# OpenAPI title for documentation (Optional)
API_TITLE=Fastify Production API

# OpenAPI description (Optional)
API_DESCRIPTION=Production-grade Fastify template with REST, GraphQL, Auth, and Storage

# OpenAPI contact name (Optional)
API_CONTACT_NAME=API Support

# OpenAPI contact email (Optional)
API_CONTACT_EMAIL=support@example.com

# OpenAPI contact URL (Optional)
API_CONTACT_URL=https://example.com/support

# OpenAPI license name (Optional)
API_LICENSE_NAME=MIT

# OpenAPI license URL (Optional)
API_LICENSE_URL=https://opensource.org/licenses/MIT

# Comma-separated OpenAPI server URLs (Optional)
API_SERVERS=http://localhost:3000

# Primary allowed CORS origin (Optional)
CORS_ORIGIN=http://localhost:3000

# Comma-separated exact origins, wildcard subdomains, and regex patterns (Optional)
CORS_ORIGINS=

# Enable credentials (cookies/auth) in CORS headers (Optional)
CORS_CREDENTIALS=true

# Allow common frontend dev ports (3000, 5173, 4200, 8081) (Optional)
CORS_DEV_PRESET=true

# Secret key for signing access JWTs (min 32 chars) (REQUIRED)
JWT_SECRET=

# Lifespan of access JWT (Optional)
JWT_EXPIRES_IN=15m

# Lifespan of refresh tokens in days (Optional)
REFRESH_TOKEN_EXPIRES_DAYS=7

# Secret key for signing HTTP cookies (min 32 chars) (REQUIRED)
COOKIE_SECRET=

# Domain attribute for session cookies (Optional)
COOKIE_DOMAIN=localhost

# Require HTTPS for cookies (true in production) (Optional)
COOKIE_SECURE=false

# PostgreSQL connection URL (REQUIRED)
DATABASE_URL=

# Redis connection URL for caching, rate limiting, and BullMQ (REQUIRED)
REDIS_URL=redis://localhost:6379

# Enable distributed rate limiting (Optional)
RATE_LIMIT_ENABLED=true

# Max requests per sliding window (Optional)
RATE_LIMIT_MAX=100

# Sliding window duration in milliseconds (Optional)
RATE_LIMIT_WINDOW_MS=60000

# Behavior when Redis is down: open or closed (Optional)
RATE_LIMIT_FAIL_MODE=closed

# Storage driver: local or s3 (Optional)
STORAGE_DRIVER=local

# Allow local storage in production (unsafe fallback) (Optional)
STORAGE_ALLOW_LOCAL_IN_PROD=false

# S3 / MinIO bucket name (Optional)
S3_BUCKET=app-uploads

# AWS / S3 region (Optional)
S3_REGION=us-east-1

# Custom S3 endpoint for MinIO, Cloudflare R2, Wasabi (Optional)
S3_ENDPOINT=

# S3 access key ID (Optional)
S3_ACCESS_KEY_ID=

# S3 secret access key (Optional)
S3_SECRET_ACCESS_KEY=

# Max allowed file upload size in MB (Optional)
STORAGE_MAX_FILE_SIZE_MB=25

# Enable GraphiQL playground in non-production (Optional)
GRAPHQL_PLAYGROUND_ENABLED=true

# Maximum allowable GraphQL query AST depth (Optional)
GRAPHQL_MAX_DEPTH=10

# Maximum query complexity score threshold (Optional)
GRAPHQL_MAX_COMPLEXITY=1000

# Enforce persisted query allow-list mode (Optional)
GRAPHQL_PERSISTED_QUERIES_ONLY=false

